using Gtk 4.0;
using Adw 1;

translation-domain "tick";

// DESIGN.md 3.1: toast overlay > (login | navigation split view > overlay split view).
// Breakpoints (3.3) are added in code, because B2 and B3 also set TickWindow:narrow.
template $TickWindow: Adw.ApplicationWindow {
  title: _("Tick");
  default-width: 1180;
  default-height: 760;
  width-request: 360;
  height-request: 294;

  content: Adw.ToastOverlay toast_overlay {
    child: Gtk.Stack stack {
      transition-type: none;

      Gtk.StackPage {
        name: "main";

        child: Adw.NavigationSplitView split_view {
          min-sidebar-width: 240;
          max-sidebar-width: 300;
          sidebar-width-fraction: 0.22;

          sidebar: Adw.NavigationPage sidebar_page {
            title: _("Tick");
            tag: "sidebar";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                show-title: false;

                [start]
                Gtk.Button sidebar_add_button {
                  visible: false;
                  icon-name: "list-add-symbolic";
                  tooltip-text: _("Add Task (Q)");
                  action-name: "win.quick-add";

                  accessibility {
                    label: _("Add Task");
                  }
                }

                [end]
                Gtk.MenuButton main_menu_button {
                  icon-name: "open-menu-symbolic";
                  menu-model: main_menu;
                  primary: true;
                  tooltip-text: _("Main Menu");

                  accessibility {
                    label: _("Main Menu");
                  }
                }
              }

              content: Gtk.Overlay sidebar_overlay {
                child: Gtk.ScrolledWindow {
                  hscrollbar-policy: never;
                  focusable: false;

                  child: Gtk.ListView sidebar_list {
                    styles [
                      "navigation-sidebar",
                    ]

                    accessibility {
                      label: _("Views");
                    }
                  };
                };

                [overlay]
                Gtk.Box sidebar_drop_line {
                  visible: false;
                  can-target: false;
                  halign: start;
                  valign: start;
                  accessible-role: presentation;

                  styles [
                    "tick-drop-indicator",
                  ]
                }
              };
            };
          };

          content: Adw.NavigationPage content_page {
            title: _("Today");
            tag: "content";

            child: Adw.OverlaySplitView detail_split {
              sidebar-position: end;
              show-sidebar: false;
              // Escape closes a picker first, then the pane (TickWindow handles it), never both.
              pin-sidebar: true;
              min-sidebar-width: 340;
              max-sidebar-width: 420;
              sidebar-width-fraction: 0.38;

              content: Adw.ToolbarView {
                styles [
                  "tick-list-pane",
                ]

                [top]
                Adw.HeaderBar list_header {
                  title-widget: Adw.WindowTitle window_title {
                    opacity: 0;
                  };

                  [start]
                  Gtk.Button add_button {
                    icon-name: "list-add-symbolic";
                    tooltip-text: _("Add Task (Q)");
                    action-name: "win.quick-add";

                    accessibility {
                      label: _("Add Task");
                    }
                  }

                  [end]
                  Gtk.MenuButton view_menu_button {
                    visible: false;
                    icon-name: "view-more-symbolic";
                    tooltip-text: _("View Menu");

                    accessibility {
                      label: _("View Menu");
                    }
                  }

                  [end]
                  Gtk.MenuButton sync_button {
                    visible: false;

                    styles [
                      "flat",
                    ]

                    accessibility {
                      label: _("Sync Status");
                    }
                  }
                }

                content: Gtk.Overlay list_overlay {
                  child: Gtk.ScrolledWindow list_scroller {
                    hscrollbar-policy: never;
                    focusable: false;

                    child: Adw.ClampScrollable {
                      maximum-size: 720;
                      tightening-threshold: 560;

                      child: Gtk.ListView task_list {
                        styles [
                          "tick-task-list",
                        ]

                        accessibility {
                          label: _("Tasks");
                        }
                      };
                    };
                  };

                  [overlay]
                  Gtk.Box drop_line {
                    visible: false;
                    can-target: false;
                    halign: start;
                    valign: start;
                    accessible-role: presentation;

                    styles [
                      "tick-drop-indicator",
                    ]
                  }
                };
              };

              sidebar: Adw.ToolbarView detail_view {
                [top]
                Adw.HeaderBar {
                  show-title: false;
                  // The navigation back button belongs to the list's header bar (3.4).
                  show-back-button: false;

                  [start]
                  Gtk.Button detail_back_button {
                    visible: false;
                    icon-name: "go-previous-symbolic";
                    tooltip-text: _("Close Task (Esc)");
                    action-name: "win.close-task";

                    accessibility {
                      label: _("Close Task");
                    }
                  }

                  [end]
                  Gtk.Button detail_close_button {
                    icon-name: "sidebar-show-right-symbolic";
                    tooltip-text: _("Close Task (Esc)");
                    action-name: "win.close-task";

                    accessibility {
                      label: _("Close Task");
                    }
                  }

                  [end]
                  Gtk.MenuButton detail_menu_button {
                    icon-name: "view-more-symbolic";
                    menu-model: task_menu;
                    tooltip-text: _("Task Menu");

                    accessibility {
                      label: _("Task Menu");
                    }
                  }
                }

                content: Adw.Bin detail_bin {};
              };
            };
          };
        };
      }

      Gtk.StackPage {
        name: "login";

        child: $TickLoginPage login_page {};
      }
    };
  };
}

menu task_menu {
  section {
    item (_("Complete"), "win.detail-complete")
    item (_("Move to..."), "win.detail-move")
  }

  section {
    item (_("Delete Task"), "win.detail-delete")
  }
}

menu main_menu {
  section {
    item (_("About Tick"), "app.about")
  }

  section {
    item (_("Quit"), "app.quit")
  }
}
